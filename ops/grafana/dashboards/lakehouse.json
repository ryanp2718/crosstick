{
  "title": "Lakehouse / Batch DQ",
  "uid": "lakehouse",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "tags": ["crosstick", "lakehouse", "data-quality"],
  "panels": [
    {
      "id": 1,
      "title": "Gold scorecard reporting date",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_scorecard_date_seconds * 1000", "legendFormat": "date", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "title": "Bronze freshness (newest dataset) — red >30m = materializer stuck",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "min(lake_freshness_seconds{layer=\"bronze\"})", "legendFormat": "bronze", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 1800 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3,
      "title": "Lake-exporter health (refresh age / errors)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "time() - lake_exporter_last_success_seconds", "legendFormat": "refresh age (s)", "refId": "A" },
        { "expr": "lake_exporter_refresh_errors_total", "legendFormat": "errors", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 4,
      "title": "Basis observations / base",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_basis_obs", "legendFormat": "{{base}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 5,
      "title": "Lake freshness / layer+dataset (s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "lake_freshness_seconds", "legendFormat": "{{layer}}/{{dataset}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] } }
    },
    {
      "id": 6,
      "title": "Gold DQ violations / check (latest build)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (check) (gold_dq_violations)", "legendFormat": "{{check}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] } }
    },
    {
      "id": 7,
      "title": "Capture-clock backward steps / venue — clean ~150, w32time-stopped ~7000",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_dq_violations{check=\"clock_monotonic\"}", "legendFormat": "{{exchange}} {{symbol}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    },
    {
      "id": 8,
      "title": "Worst clock step / venue (ms) — red >60s breaches the silver reorder window",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_dq_clock_worst_ms", "legendFormat": "{{exchange}} {{symbol}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 60000 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    },
    {
      "id": 9,
      "title": "Gold latency percentiles / venue (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_dq_latency_ms", "legendFormat": "{{exchange}} {{symbol}} {{quantile}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] } }
    },
    {
      "id": 10,
      "title": "Stablecoin basis (bps) / base+stat",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_basis_bps", "legendFormat": "{{base}} {{stat}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] } }
    },
    {
      "id": 11,
      "title": "Scorecard — checks with violations (latest build)",
      "type": "table",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "gold_dq_violations > 0", "instant": true, "format": "table", "refId": "A" }
      ],
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true } } }
      ]
    }
  ]
}
