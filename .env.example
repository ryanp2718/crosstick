# Copy to .env (gitignored) and set your own values: `cp .env.example .env`
# Garage needs real-format secrets, so generate them rather than typing them:
#   GARAGE_RPC_SECRET / S3_SECRET_KEY: `openssl rand -hex 32`
#   GARAGE_ADMIN_TOKEN:                `openssl rand -hex 16`
#   S3_ACCESS_KEY: "GK" + `openssl rand -hex 12` (Garage rejects any other shape)
# garage-init imports S3_ACCESS_KEY / S3_SECRET_KEY as the app services' key.
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
S3_ACCESS_KEY=GKchange-me
S3_SECRET_KEY=change-me
GF_SECURITY_ADMIN_PASSWORD=change-me

# Bronze (raw `lake` bucket) retention. Only SEEDS the lifecycle rule on a bucket
# that has none, so a hand-tuned retention survives restarts; to change it on a
# live bucket, PUT a new lifecycle config on `lake` (see common/garage.py). Silver and gold
# never expire, which is why the silver tape datasets are the durable copy.
# BRONZE_EXPIRE_DAYS=30

# ─── Cloudflare R2 (Phase A: silver + gold off-box; bronze stays on Garage) ───
# Leave the whole block unset for an all-local stack: the lake-exporter falls back
# to Garage for every layer, byte-identical to before. At cutover, uncomment and
# fill from the R2 dashboard; real values live only in .env, never here (no account
# id or token in a tracked file). Runbook: docs/RUNBOOK_r2_cutover.md.
# S3_ENDPOINT points the DERIVED layers (silver/gold) at R2; bronze is pinned to
# Garage in docker-compose. Region is always "auto" for R2.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# Read-write token for the silver/gold batch (scope to the silver + gold buckets):
# R2_ACCESS_KEY=change-me
# R2_SECRET_KEY=change-me
# Read-only token for the always-on lake-exporter (read-only on silver + gold):
# R2_RO_ACCESS_KEY=change-me
# R2_RO_SECRET_KEY=change-me
