# Copy to .env (gitignored) and set your own values: `cp .env.example .env`
# For local dev any non-empty values work; for anything reachable beyond localhost, use strong unique secrets.
# S3_ACCESS_KEY / S3_SECRET_KEY must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (the app services authenticate to MinIO with them).
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
GF_SECURITY_ADMIN_PASSWORD=change-me

# ─── Cloudflare R2 (Phase A: silver + gold off-box; bronze stays on MinIO) ───
# Leave the whole block unset for an all-MinIO stack: the lake-exporter falls back
# to MinIO for every layer, byte-identical to before. At cutover, uncomment and
# fill from the R2 dashboard; real values live only in .env, never here (no account
# id or token in a tracked file). Runbook: docs/RUNBOOK_r2_cutover.md.
# S3_ENDPOINT points the DERIVED layers (silver/gold) at R2; bronze is pinned to
# MinIO in docker-compose. Region is always "auto" for R2.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# Read-write token for the silver/gold batch (scope to the silver + gold buckets):
# R2_ACCESS_KEY=change-me
# R2_SECRET_KEY=change-me
# Read-only token for the always-on lake-exporter (read-only on silver + gold):
# R2_RO_ACCESS_KEY=change-me
# R2_RO_SECRET_KEY=change-me
